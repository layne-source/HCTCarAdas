<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_dialog_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADAS 设置"
            android:textColor="@color/adas_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="车辆高度与镜头视场角会影响距离估计"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/adas_divider" />

    <ScrollView
        android:id="@+id/settings_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_surface_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="车辆类型"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/vehicle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rb_sedan"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="轿车"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_suv"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="SUV"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_truck"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="货车"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="摄像头视野范围"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/fov_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rb_fov_90"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="窄视野（90度）"
                android:text="窄视野"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_fov_100"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="标准视野（100度）"
                android:text="标准视野"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_fov_120"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="广视野（120度）"
                android:text="广视野"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="声音提醒"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="前向碰撞警告"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="碰撞风险很高时提醒"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_fcw_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="前向碰撞警告声音"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="车距过近提醒"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="跟车距离过近时提醒"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_hmw_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="车距过近提醒声音"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="前车起步提醒"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="等候时前车起步提醒"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_lvsa_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="前车起步提醒声音"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/adas_divider" />

        <LinearLayout
            android:id="@+id/calibration_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADAS 校准"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="按当前镜头重新建立参考线"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/calibration_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未校准"
                android:textColor="@color/adas_accent_bright"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
