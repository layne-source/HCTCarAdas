<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADAS 设置"
        android:textColor="#FFF5F7FA"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="车型"
        android:textColor="#FF8FA3B2"
        android:textSize="11sp" />

    <RadioGroup
        android:id="@+id/vehicle_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_sedan"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="轿车"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_suv"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="SUV"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_truck"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="货车"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="镜头 HFOV"
        android:textColor="#FF8FA3B2"
        android:textSize="11sp" />

    <RadioGroup
        android:id="@+id/fov_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_fov_90"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="90°"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_fov_100"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="100°"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_fov_120"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:buttonTint="#FF72D8C8"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="120°"
            android:textColor="#FFE8EEF2"
            android:textSize="12sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/calibration_action"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/hud_corner_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADAS 校准"
            android:textColor="#FFF5F7FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calibration_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未校准"
            android:textColor="#FF7BE7D4"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
