<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_dialog_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/adas_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/adas_divider" />

    <ScrollView
        android:id="@+id/settings_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_surface_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/vehicle_type"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/vehicle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rb_sedan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vehicle_sedan"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_suv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vehicle_suv"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_truck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vehicle_truck"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fov_title"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/fov_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rb_fov_90"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:contentDescription="@string/fov_narrow"
                android:text="@string/fov_narrow"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_fov_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:contentDescription="@string/fov_standard"
                android:text="@string/fov_standard"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_fov_120"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/settings_option"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:contentDescription="@string/fov_wide"
                android:text="@string/fov_wide"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/settings_option_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/audio_alerts"
            android:textColor="@color/adas_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fcw_title"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/fcw_summary"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_fcw_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/fcw_content_desc"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hmw_title"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/hmw_summary"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_hmw_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/hmw_content_desc"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/settings_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lvsa_title"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/lvsa_summary"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_lvsa_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/lvsa_content_desc"
                android:minWidth="48dp"
                android:padding="0dp"
                android:showText="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/adas_divider" />

        <LinearLayout
            android:id="@+id/calibration_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/calibration_title"
                    android:textColor="@color/adas_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/calibration_summary"
                    android:textColor="@color/adas_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/calibration_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_status_unconfigured"
                android:textColor="@color/adas_accent_bright"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
