<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adas_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1117">

    <TextureView
        android:id="@+id/usb_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.hct.adas.VehicleOverlayView
        android:id="@+id/vehicle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="2026-09-19  12:00:00"
            android:textColor="#FFF4F7FA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="360dp"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/app_bootstrap_status"
            android:textColor="#C2D0DAE2"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/speed_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="-- km/h"
            android:textColor="#FFF5F8FA"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/settings_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="安装设置"
        android:focusable="true"
        android:onClick="openCalibrationFromSettings"
        android:padding="10dp"
        android:src="@drawable/ic_settings_adas"
        android:tint="#FF72D8C8" />

    <FrameLayout
        android:id="@+id/calibration_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#28070C12"
        android:elevation="20dp"
        android:visibility="gone">

        <com.hct.adas.CalibrationOverlayView
            android:id="@+id/calibration_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/calibration_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/calibration_cancel"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:background="@drawable/hud_debug_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:onClick="cancelCalibrationOverlay"
                android:text="取消"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/calibration_confirm"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hud_primary_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:onClick="confirmCalibrationOverlay"
                android:text="校正"
                android:textColor="#FF06110F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/simulation_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/hud_debug_button"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="室内模拟测试"
        android:textColor="#FF80D8FF"
        android:textSize="12sp" />
</FrameLayout>
