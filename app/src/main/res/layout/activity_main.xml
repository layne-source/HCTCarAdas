<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <TextureView
        android:id="@+id/usb_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.hct.adas.VehicleOverlayView
        android:id="@+id/vehicle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_bootstrap_status"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/calibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/calibration_required"
            android:textColor="#FFFFD180"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
