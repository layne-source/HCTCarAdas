<resources>
    <style name="Theme.HctAdas" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/adas_accent</item>
        <item name="android:windowBackground">@color/adas_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/adas_background</item>
        <item name="android:navigationBarColor">@color/adas_background</item>
    </style>

    <style name="Theme.HctAdas.SettingsDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/adas_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
