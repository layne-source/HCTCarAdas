<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E02C6973" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/adas_accent_bright" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#D61C3D48"
                android:endColor="#D61B2D39" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/adas_option_border" />
        </shape>
    </item>
</selector>
