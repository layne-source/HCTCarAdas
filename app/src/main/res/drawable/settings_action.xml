<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/adas_action_pressed" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/adas_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/adas_option_background" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/adas_option_border" />
        </shape>
    </item>
</selector>
