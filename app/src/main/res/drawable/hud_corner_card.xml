<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E02B4147" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#9072D8C8" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#D60D151C"
                android:startColor="#D61C2B35" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#3A72D8C8" />
        </shape>
    </item>
</selector>
