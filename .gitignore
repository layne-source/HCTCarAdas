# ===== Build artifacts & temporary files =====
*.tmp
*.log
*.ap_
*.aab
*.dex
*.class
*.hprof
bin/
gen/
out/

# APK: ignore generated APKs, but preserve committed release artifacts
*.apk
!app/release/*.apk

# ===== Android Studio / Gradle =====
.gradle/
build/
*/build/
local.properties
*.iml
.navigation/
captures/
.externalNativeBuild/
.externalNativeBuild
.cxx/
.kotlin/

# ===== Keystore & signing config =====
*.keystore
keystore.properties
signing.properties
# Ignore custom/developer JKS keys, but preserve the repo's platform signing key
*.jks
!app/platform.jks
!platform.jks

# ===== IDE / Editors =====
.idea/
.vscode/

# ===== Lint output =====
lint-results*.html
lint-results*.xml

